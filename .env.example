# NivaGlow AI WhatsApp Sales & Support OS
PORT=3000
NODE_ENV=development

# Database (SQLite default for zero-friction local run; swap to postgresql:// for production)
DATABASE_URL="file:./dev.db"

# WhatsApp Cloud API credentials
WHATSAPP_VERIFY_TOKEN="niva-glow-verify-token"
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_ACCESS_TOKEN="your_access_token"
WHATSAPP_GRAPH_VERSION="v23.0"

# AI Provider
OPENAI_API_KEY="your_openai_api_key"

# Endpoints
D2C_ORDER_API_URL="http://localhost:3000/api/orders"
D2C_RETURN_API_URL="http://localhost:3000/api/returns"
D2C_PRODUCT_API_URL="http://localhost:3000/api/products"
D2C_TICKET_API_URL="http://localhost:3000/api/tickets"
D2C_PROACTIVE_QUEUE_URL="http://localhost:3000/api/proactive-queue"
SARVAM_VOICE_AGENT_URL="http://localhost:3000/api/sarvam-voice"
